-- Reference implementation of the `List::filter` function.
-- @type List(a), Fn(a -> Bool) -> List(a)
fn filter list f =
	fn reverseAndCleanup list =
		let reversedList = List::reverse(list),

		do(
			List::dispose(list),
			StdUtils::identity(reversedList)
		).

	-- helper for tail-recursive implementation
	fn filterRec acc list f =
		let listHead = List::List:head(list),

		List::List:match(
			list,
			-- Empty
			-- list was constructed in the reverse order -
			-- reverse the result to get the original order
			reverseAndCleanup(acc),
			-- List(_)
			filterRec(
				-- prepend the current element (list head)
				-- (if condition is met, otherwise ignore)
				-- to the rest of the (accumulated) list
				ifElse(
					f(listHead),
					List::List(listHead, acc),
					acc
				),
				-- and do the same with the rest of the list
				List::List:tail(list),
				-- don't forget to pass along the function
				f
			)
		).

	filterRec(List::Empty(), list, f).
